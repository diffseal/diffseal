    {
      "kind": "terraform",
      "name": "round 9 (Codex): evaluator, Terraform, policy, plan: a splat over a sensitive list is the list, judged and kept sensitive",
      "root": "r",
      "head": {
        "r/main.tf": "terraform {\n  backend \"s3\" {}\n}\nvariable \"cidrs\" {\n  type      = list(string)\n  sensitive = true\n  default   = [\"0.0.0.0/0\"]\n}\nresource \"aws_security_group_rule\" \"s\" {\n  type              = \"ingress\"\n  security_group_id = \"sg-1\"\n  from_port         = 22\n  to_port           = 22\n  protocol          = \"tcp\"\n  cidr_blocks       = var.cidrs[*]\n}\n"
      },
      "expect": {
        "changedAddresses": [
          "create aws_security_group_rule.s"
        ],
        "changes": [
          {
            "address": "aws_security_group_rule.s",
            "action": "create",
            "confidence": "proven",
            "after": {
              "type": "ingress",
              "security_group_id": "sg-1",
              "from_port": 22,
              "to_port": 22,
              "protocol": "tcp"
            }
          }
        ],
        "findings": [
          {
            "ruleId": "network.open-ingress",
            "resource": "aws_security_group_rule.s",
            "status": "FAIL",
            "preExisting": null,
