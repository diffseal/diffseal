  {
   "kind": "replay",
   "name": "a root moved to a directory whose content is mostly new is a deletion and a new root, not a move",
   "base": {
    "a/main.tf": "terraform {\n  backend \"s3\" {}\n}\n",
    "a/secrets.tf": "resource \"aws_secretsmanager_secret\" \"argocd\" {\n  name                    = \"argocd\"\n  recovery_window_in_days = 0\n}\nresource \"aws_route53_zone\" \"z\" {\n  name = \"example.com\"\n}\n",
    "other/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name = \"other\"\n}\n"
   },
   "head": {
    "b/main.tf": "terraform {\n  backend \"s3\" {}\n}\n# new stack\n",
    "b/q.tf": "resource \"aws_sqs_queue\" \"q\" {\n  name = \"fresh\"\n}\n",
    "b/more.tf": "resource \"aws_sqs_queue\" \"r\" {\n  name = \"x\"\n}\n",
    "other/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name = \"other\"\n}\n"
   },
   "expect": {
    "replayedRoots": [
     "a",
     "b"
