        "r/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_db_instance\" \"d\" {\n  identifier     = \"d\"\n  instance_class = \"db.r6g.large\"\n  multi_az       = \"false\"\n}\n"
      },
      "head": {
        "r/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_db_instance\" \"d\" {\n  identifier     = \"d\"\n  instance_class = \"db.r6g.large\"\n  multi_az       = \"true\"\n}\n"
      },
      "expect": {
        "changedAddresses": [
          "update aws_db_instance.d"
        ],
        "changes": [
          {
            "address": "aws_db_instance.d",
