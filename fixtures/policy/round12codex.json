{
  "suite": "policy/round12codex",
  "description": "Executable specification fixtures exported from src/policy/round12codex.test.ts",
  "cases": [
    {
      "kind": "terraform",
      "name": "round 12 codex: policy and cost: a KMS data source lookup of an AWS managed alias is not a customer managed key",
      "root": "r",
      "head": {
        "r/main.tf": "terraform {\n  backend \"s3\" {}\n}\ndata \"aws_kms_alias\" \"sqs\" {\n  name = \"alias/aws/sqs\"\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name              = \"q\"\n  kms_master_key_id = data.aws_kms_alias.sqs.target_key_arn\n}\n"
      },
      "policy": {
        "requireCustomerManagedKeys": true
      },
      "expect": {
        "changedAddresses": [
          "create aws_sqs_queue.q"
        ],
        "changes": [
          {
            "address": "aws_sqs_queue.q",
            "action": "create",
            "confidence": "proven",
            "after": {
              "name": "q"
            }
          }
        ],
        "findings": [
          {
            "ruleId": "sqs.encryption",
            "resource": "aws_sqs_queue.q",
            "status": "WARN",
            "preExisting": null,
            "detailContains": "SSE-KMS with the AWS managed key aws/sqs; policy requires a customer managed KMS key"
          },
          {
            "ruleId": "sqs.dlq",
            "resource": "aws_sqs_queue.q",
            "status": "WARN",
            "preExisting": null,
            "detailContains": "No dead-letter queue: messages that keep failing are dropped after the retention period"
          }
        ],
        "blast": [
          {
            "resource": "aws_sqs_queue.q",
            "action": "create",
            "severity": "INFO",
            "dataLoss": false,
            "reasonContains": "Creates aws_sqs_queue"
          }
        ],
        "cost": {
          "fixedMonthlyDeltaUsd": 0,
          "items": [
            {
              "resource": "aws_sqs_queue.q",
              "kind": "usage",
              "noteContains": "No fixed charge; billed by requests, storage or duration"
            }
          ]
        },
        "gate": {
          "result": "pass"
        }
      }
    },
