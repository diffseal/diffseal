            "service": "s3",
            "operation": "PutObject",
            "actions": [
              "s3:PutObject"
            ],
            "resource": {
              "kind": "literal",
              "value": "b"
            },
            "file": "a.ts"
          },
          {
            "service": "sqs",
            "operation": "SendMessage",
            "actions": [
