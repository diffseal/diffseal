{
  "source": "Diffseal synthetic demo",
  "base": {
    ".github/workflows/diffseal.yml": "name: Diffseal PR review\non:\n  pull_request:\n\npermissions:\n  contents: read\n  pull-requests: write\n\njobs:\n  diffseal:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n\n      - uses: diffseal/diffseal@v0.2.0-beta\n        with:\n          mode: pr\n          advisory: 'true'\n",
    "README.md": "# Acme Fulfillment demo for Diffseal\n\nSynthetic repository showing how Diffseal reviews Terraform changes without AWS credentials or running `terraform`.\n\n## Repository layout\n\n- `infra/modules/fulfillment/main.tf`: Reusable Terraform module provisioning an S3 bucket (`acme-prod-shipment-manifests`), an SQS queue with a dead-letter queue (`acme-prod-dispatch`), a DynamoDB table (`acme-prod-shipments`), an IAM role (`acme-prod-fulfillment-lambda`), and a Lambda function (`acme-prod-fulfillment`).\n- `infra/envs/prod/fulfillment/main.tf`: Production Terraform root calling `module.fulfillment`.\n- `src/fulfillmentHandler.ts`: TypeScript Lambda handler using `@aws-sdk/client-s3`, `@aws-sdk/client-dynamodb`, and `@aws-sdk/client-sqs`.\n- `.github/workflows/diffseal.yml`: GitHub Action workflow configured with `uses: diffseal/diffseal@v0.2.0-beta` and `advisory: 'true'`.\n\n## Demo branches\n\nEach branch represents a pull request against `main` and contains a `PR.md` file with the exact output from running the Diffseal CLI:\n\n1. `pr/replace-database`: Changes the DynamoDB table `hash_key` from `shipment_id` to `tracking_number`. Diffseal detects that `hash_key` forces replacement of `module.fulfillment.aws_dynamodb_table.shipments` and sets `Gate: BLOCK`.\n2. `pr/harmless-change`: Increases the Lambda `timeout` from `15` to `30` seconds in `infra/modules/fulfillment/main.tf`. Diffseal classifies the change as an in-place update with no policy or blast-radius findings and sets `Gate: PASS`.\n\n## Running the checks locally\n\nFrom the `diffseal` repository:\n\n```bash\n# Replay either pull request branch against main\nbun run src/cli.ts replay --repo ../diffseal-demo --commit pr/replace-database --base main --out-dir /tmp/diffseal-demo-runs\nbun run src/cli.ts replay --repo ../diffseal-demo --commit pr/harmless-change --base main --out-dir /tmp/diffseal-demo-runs\n```\n",
    "infra/envs/prod/fulfillment/main.tf": "terraform {\n  backend \"s3\" {\n    bucket = \"acme-terraform-state\"\n    key    = \"fulfillment/terraform.tfstate\"\n    region = \"eu-north-1\"\n  }\n}\n\nprovider \"aws\" {\n  region = \"eu-north-1\"\n}\n\nmodule \"fulfillment\" {\n  source      = \"../../../modules/fulfillment\"\n  environment = \"prod\"\n}\n",
    "infra/modules/fulfillment/main.tf": "variable \"environment\" {\n  type = string\n}\n\nlocals {\n  name = \"acme-${var.environment}\"\n}\n\nresource \"aws_s3_bucket\" \"manifests\" {\n  bucket = \"${local.name}-shipment-manifests\"\n}\n\nresource \"aws_s3_bucket_public_access_block\" \"manifests\" {\n  bucket                  = aws_s3_bucket.manifests.id\n  block_public_acls       = true\n  block_public_policy     = true\n  ignore_public_acls      = true\n  restrict_public_buckets = true\n}\n\nresource \"aws_s3_bucket_versioning\" \"manifests\" {\n  bucket = aws_s3_bucket.manifests.id\n  versioning_configuration {\n    status = \"Enabled\"\n  }\n}\n\nresource \"aws_sqs_queue\" \"dispatch_dlq\" {\n  name = \"${local.name}-dispatch-dlq\"\n}\n\nresource \"aws_sqs_queue\" \"dispatch\" {\n  name = \"${local.name}-dispatch\"\n  redrive_policy = jsonencode({\n    deadLetterTargetArn = aws_sqs_queue.dispatch_dlq.arn\n    maxReceiveCount     = 5\n  })\n}\n\nresource \"aws_dynamodb_table\" \"shipments\" {\n  name         = \"${local.name}-shipments\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"shipment_id\"\n\n  attribute {\n    name = \"shipment_id\"\n    type = \"S\"\n  }\n\n  point_in_time_recovery {\n    enabled = true\n  }\n}\n\nresource \"aws_iam_role\" \"lambda\" {\n  name = \"${local.name}-fulfillment-lambda\"\n  assume_role_policy = jsonencode({\n    Version   = \"2012-10-17\"\n    Statement = [{ Effect = \"Allow\", Principal = { Service = \"lambda.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n  })\n}\n\nresource \"aws_iam_role_policy_attachment\" \"logs\" {\n  role       = aws_iam_role.lambda.name\n  policy_arn = \"arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole\"\n}\n\ndata \"aws_iam_policy_document\" \"lambda\" {\n  statement {\n    actions   = [\"s3:PutObject\", \"s3:GetObject\"]\n    resources = [\"${aws_s3_bucket.manifests.arn}/*\"]\n  }\n  statement {\n    actions   = [\"sqs:SendMessage\"]\n    resources = [aws_sqs_queue.dispatch.arn]\n  }\n  statement {\n    actions   = [\"dynamodb:PutItem\", \"dynamodb:GetItem\"]\n    resources = [aws_dynamodb_table.shipments.arn]\n  }\n}\n\nresource \"aws_iam_role_policy\" \"lambda\" {\n  role   = aws_iam_role.lambda.id\n  policy = data.aws_iam_policy_document.lambda.json\n}\n\nresource \"aws_lambda_function\" \"fulfillment\" {\n  function_name = \"${local.name}-fulfillment\"\n  role          = aws_iam_role.lambda.arn\n  package_type  = \"Image\"\n  image_uri     = \"123456789012.dkr.ecr.eu-north-1.amazonaws.com/acme-fulfillment:latest\"\n  memory_size   = 512\n  timeout       = 15\n\n  environment {\n    variables = {\n      MANIFEST_BUCKET_NAME = aws_s3_bucket.manifests.id\n      DISPATCH_QUEUE_URL   = aws_sqs_queue.dispatch.url\n      SHIPMENTS_TABLE_NAME = aws_dynamodb_table.shipments.name\n    }\n  }\n}\n",
    "package.json": "{\n  \"name\": \"acme-fulfillment\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"dependencies\": {\n    \"@aws-sdk/client-dynamodb\": \"^3.600.0\",\n    \"@aws-sdk/client-s3\": \"^3.600.0\",\n    \"@aws-sdk/client-sqs\": \"^3.600.0\"\n  }\n}\n",
    "src/fulfillmentHandler.ts": "import { SQSClient, SendMessageCommand } from '@aws-sdk/client-sqs';\nimport { S3Client, PutObjectCommand, GetObjectCommand } from '@aws-sdk/client-s3';\nimport { DynamoDBClient, PutItemCommand, GetItemCommand } from '@aws-sdk/client-dynamodb';\n\nconst sqs = new SQSClient({ region: 'eu-north-1' });\nconst s3 = new S3Client({ region: 'eu-north-1' });\nconst dynamo = new DynamoDBClient({ region: 'eu-north-1' });\n\nexport async function createShipment(shipmentId: string, customerId: string, manifestPdf: Buffer) {\n  await s3.send(\n    new PutObjectCommand({\n      Bucket: process.env.MANIFEST_BUCKET_NAME,\n      Key: `manifests/${shipmentId}.pdf`,\n      Body: manifestPdf,\n    })\n  );\n\n  await dynamo.send(\n    new PutItemCommand({\n      TableName: process.env.SHIPMENTS_TABLE_NAME,\n      Item: {\n        shipment_id: { S: shipmentId },\n        customer_id: { S: customerId },\n        created_at: { S: new Date().toISOString() },\n      },\n    })\n  );\n\n  await sqs.send(\n    new SendMessageCommand({\n      QueueUrl: process.env.DISPATCH_QUEUE_URL,\n      MessageBody: JSON.stringify({ shipmentId, customerId }),\n    })\n  );\n}\n\nexport async function getShipmentManifest(shipmentId: string) {\n  return s3.send(\n    new GetObjectCommand({\n      Bucket: process.env.MANIFEST_BUCKET_NAME,\n      Key: `manifests/${shipmentId}.pdf`,\n    })\n  );\n}\n\nexport async function getShipmentRecord(shipmentId: string) {\n  return dynamo.send(\n    new GetItemCommand({\n      TableName: process.env.SHIPMENTS_TABLE_NAME,\n      Key: {\n        shipment_id: { S: shipmentId },\n      },\n    })\n  );\n}\n"
  },
  "heads": [
    {
      "name": "replace-database",
      "files": {
        ".github/workflows/diffseal.yml": "name: Diffseal PR review\non:\n  pull_request:\n\npermissions:\n  contents: read\n  pull-requests: write\n\njobs:\n  diffseal:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n\n      - uses: diffseal/diffseal@v0.2.0-beta\n        with:\n          mode: pr\n          advisory: 'true'\n",
        "PR.md": "## Diffseal: 99bdabfab Key shipments table by tracking_number\n_Viktor Voltaire, 2026-10-25. 1 Terraform file(s) changed._\n\n**Gate: BLOCK**\n\n- CRITICAL: module.fulfillment.aws_dynamodb_table.shipments: Replaces aws_dynamodb_table (forced by changing hash_key): loses the items in the table\n\n| Changes | Findings to review | Fixed monthly cost |\n| :-- | :-- | :-- |\n| 1 replace, 1 update | none | $0 |\n\n### Changes\n\n| Risk | Resource | Action | Why |\n| :-- | :-- | :-- | :-- |\n| CRITICAL | `module.fulfillment.aws_dynamodb_table.shipments` | replace | Replaces aws_dynamodb_table (forced by changing hash_key): loses the items in the table |\n| INFO | `module.fulfillment.aws_iam_role_policy.lambda` | update | In-place update (policy reads a computed attribute of module.fulfillment.aws_dynamodb_table.shipments, which is replaced) |\n\n<details><summary>Passing, accepted and pre-existing checks (4)</summary>\n\n| Status | Check | Resource | Detail | Controls |\n| :-- | :-- | :-- | :-- | :-- |\n| WARN (pre-existing) | DynamoDB deletion protection | `module.fulfillment.aws_dynamodb_table.shipments` | Deletion protection disabled. Fix: Set deletion_protection_enabled = true on tables holding data you cannot recreate. | A.8.13 |\n| PASS | DynamoDB point-in-time recovery | `module.fulfillment.aws_dynamodb_table.shipments` | Point-in-time recovery enabled | A.8.13 |\n| PASS | DynamoDB encryption at rest | `module.fulfillment.aws_dynamodb_table.shipments` | Encrypted with an AWS owned key (DynamoDB default) | A.8.24 |\n| PASS | IAM least privilege | `module.fulfillment.aws_iam_role_policy.lambda` | Explicit actions on explicit resources | A.5.15, A.5.18, A.8.3 |\n\n</details>\n\n---\n<sub>Static replay of d40dfb51d..99bdabfab: configuration at both commits was evaluated without state, credentials or provider calls.</sub><br>\n<sub>Roots: infra/envs/prod/fulfillment.</sub><br>\n<sub>1 change(s) depend on values only known after apply; their action is likely, not proven.</sub><br>\n<sub>Diffseal 0.2.0-beta. Controls cite ISO/IEC 27001:2022 Annex A; whether a check is required is set by your policy, not by the standard.</sub>\n",
        "README.md": "# Acme Fulfillment demo for Diffseal\n\nSynthetic repository showing how Diffseal reviews Terraform changes without AWS credentials or running `terraform`.\n\n## Repository layout\n\n- `infra/modules/fulfillment/main.tf`: Reusable Terraform module provisioning an S3 bucket (`acme-prod-shipment-manifests`), an SQS queue with a dead-letter queue (`acme-prod-dispatch`), a DynamoDB table (`acme-prod-shipments`), an IAM role (`acme-prod-fulfillment-lambda`), and a Lambda function (`acme-prod-fulfillment`).\n- `infra/envs/prod/fulfillment/main.tf`: Production Terraform root calling `module.fulfillment`.\n- `src/fulfillmentHandler.ts`: TypeScript Lambda handler using `@aws-sdk/client-s3`, `@aws-sdk/client-dynamodb`, and `@aws-sdk/client-sqs`.\n- `.github/workflows/diffseal.yml`: GitHub Action workflow configured with `uses: diffseal/diffseal@v0.2.0-beta` and `advisory: 'true'`.\n\n## Demo branches\n\nEach branch represents a pull request against `main` and contains a `PR.md` file with the exact output from running the Diffseal CLI:\n\n1. `pr/replace-database`: Changes the DynamoDB table `hash_key` from `shipment_id` to `tracking_number`. Diffseal detects that `hash_key` forces replacement of `module.fulfillment.aws_dynamodb_table.shipments` and sets `Gate: BLOCK`.\n2. `pr/harmless-change`: Increases the Lambda `timeout` from `15` to `30` seconds in `infra/modules/fulfillment/main.tf`. Diffseal classifies the change as an in-place update with no policy or blast-radius findings and sets `Gate: PASS`.\n\n## Running the checks locally\n\nFrom the `diffseal` repository:\n\n```bash\n# Replay either pull request branch against main\nbun run src/cli.ts replay --repo ../diffseal-demo --commit pr/replace-database --base main --out-dir /tmp/diffseal-demo-runs\nbun run src/cli.ts replay --repo ../diffseal-demo --commit pr/harmless-change --base main --out-dir /tmp/diffseal-demo-runs\n```\n",
        "infra/envs/prod/fulfillment/main.tf": "terraform {\n  backend \"s3\" {\n    bucket = \"acme-terraform-state\"\n    key    = \"fulfillment/terraform.tfstate\"\n    region = \"eu-north-1\"\n  }\n}\n\nprovider \"aws\" {\n  region = \"eu-north-1\"\n}\n\nmodule \"fulfillment\" {\n  source      = \"../../../modules/fulfillment\"\n  environment = \"prod\"\n}\n",
        "infra/modules/fulfillment/main.tf": "variable \"environment\" {\n  type = string\n}\n\nlocals {\n  name = \"acme-${var.environment}\"\n}\n\nresource \"aws_s3_bucket\" \"manifests\" {\n  bucket = \"${local.name}-shipment-manifests\"\n}\n\nresource \"aws_s3_bucket_public_access_block\" \"manifests\" {\n  bucket                  = aws_s3_bucket.manifests.id\n  block_public_acls       = true\n  block_public_policy     = true\n  ignore_public_acls      = true\n  restrict_public_buckets = true\n}\n\nresource \"aws_s3_bucket_versioning\" \"manifests\" {\n  bucket = aws_s3_bucket.manifests.id\n  versioning_configuration {\n    status = \"Enabled\"\n  }\n}\n\nresource \"aws_sqs_queue\" \"dispatch_dlq\" {\n  name = \"${local.name}-dispatch-dlq\"\n}\n\nresource \"aws_sqs_queue\" \"dispatch\" {\n  name = \"${local.name}-dispatch\"\n  redrive_policy = jsonencode({\n    deadLetterTargetArn = aws_sqs_queue.dispatch_dlq.arn\n    maxReceiveCount     = 5\n  })\n}\n\nresource \"aws_dynamodb_table\" \"shipments\" {\n  name         = \"${local.name}-shipments\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"tracking_number\"\n\n  attribute {\n    name = \"tracking_number\"\n    type = \"S\"\n  }\n\n  point_in_time_recovery {\n    enabled = true\n  }\n}\n\nresource \"aws_iam_role\" \"lambda\" {\n  name = \"${local.name}-fulfillment-lambda\"\n  assume_role_policy = jsonencode({\n    Version   = \"2012-10-17\"\n    Statement = [{ Effect = \"Allow\", Principal = { Service = \"lambda.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n  })\n}\n\nresource \"aws_iam_role_policy_attachment\" \"logs\" {\n  role       = aws_iam_role.lambda.name\n  policy_arn = \"arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole\"\n}\n\ndata \"aws_iam_policy_document\" \"lambda\" {\n  statement {\n    actions   = [\"s3:PutObject\", \"s3:GetObject\"]\n    resources = [\"${aws_s3_bucket.manifests.arn}/*\"]\n  }\n  statement {\n    actions   = [\"sqs:SendMessage\"]\n    resources = [aws_sqs_queue.dispatch.arn]\n  }\n  statement {\n    actions   = [\"dynamodb:PutItem\", \"dynamodb:GetItem\"]\n    resources = [aws_dynamodb_table.shipments.arn]\n  }\n}\n\nresource \"aws_iam_role_policy\" \"lambda\" {\n  role   = aws_iam_role.lambda.id\n  policy = data.aws_iam_policy_document.lambda.json\n}\n\nresource \"aws_lambda_function\" \"fulfillment\" {\n  function_name = \"${local.name}-fulfillment\"\n  role          = aws_iam_role.lambda.arn\n  package_type  = \"Image\"\n  image_uri     = \"123456789012.dkr.ecr.eu-north-1.amazonaws.com/acme-fulfillment:latest\"\n  memory_size   = 512\n  timeout       = 15\n\n  environment {\n    variables = {\n      MANIFEST_BUCKET_NAME = aws_s3_bucket.manifests.id\n      DISPATCH_QUEUE_URL   = aws_sqs_queue.dispatch.url\n      SHIPMENTS_TABLE_NAME = aws_dynamodb_table.shipments.name\n    }\n  }\n}\n",
        "package.json": "{\n  \"name\": \"acme-fulfillment\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"dependencies\": {\n    \"@aws-sdk/client-dynamodb\": \"^3.600.0\",\n    \"@aws-sdk/client-s3\": \"^3.600.0\",\n    \"@aws-sdk/client-sqs\": \"^3.600.0\"\n  }\n}\n",
        "src/fulfillmentHandler.ts": "import { SQSClient, SendMessageCommand } from '@aws-sdk/client-sqs';\nimport { S3Client, PutObjectCommand, GetObjectCommand } from '@aws-sdk/client-s3';\nimport { DynamoDBClient, PutItemCommand, GetItemCommand } from '@aws-sdk/client-dynamodb';\n\nconst sqs = new SQSClient({ region: 'eu-north-1' });\nconst s3 = new S3Client({ region: 'eu-north-1' });\nconst dynamo = new DynamoDBClient({ region: 'eu-north-1' });\n\nexport async function createShipment(shipmentId: string, customerId: string, manifestPdf: Buffer) {\n  await s3.send(\n    new PutObjectCommand({\n      Bucket: process.env.MANIFEST_BUCKET_NAME,\n      Key: `manifests/${shipmentId}.pdf`,\n      Body: manifestPdf,\n    })\n  );\n\n  await dynamo.send(\n    new PutItemCommand({\n      TableName: process.env.SHIPMENTS_TABLE_NAME,\n      Item: {\n        shipment_id: { S: shipmentId },\n        customer_id: { S: customerId },\n        created_at: { S: new Date().toISOString() },\n      },\n    })\n  );\n\n  await sqs.send(\n    new SendMessageCommand({\n      QueueUrl: process.env.DISPATCH_QUEUE_URL,\n      MessageBody: JSON.stringify({ shipmentId, customerId }),\n    })\n  );\n}\n\nexport async function getShipmentManifest(shipmentId: string) {\n  return s3.send(\n    new GetObjectCommand({\n      Bucket: process.env.MANIFEST_BUCKET_NAME,\n      Key: `manifests/${shipmentId}.pdf`,\n    })\n  );\n}\n\nexport async function getShipmentRecord(shipmentId: string) {\n  return dynamo.send(\n    new GetItemCommand({\n      TableName: process.env.SHIPMENTS_TABLE_NAME,\n      Key: {\n        shipment_id: { S: shipmentId },\n      },\n    })\n  );\n}\n"
      },
      "gate": "block",
      "exit": 2,
      "finding": "Replaces aws_dynamodb_table"
    },
    {
      "name": "harmless-change",
      "files": {
        ".github/workflows/diffseal.yml": "name: Diffseal PR review\non:\n  pull_request:\n\npermissions:\n  contents: read\n  pull-requests: write\n\njobs:\n  diffseal:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n\n      - uses: diffseal/diffseal@v0.2.0-beta\n        with:\n          mode: pr\n          advisory: 'true'\n",
        "PR.md": "## Diffseal: fb2f40942 Increase fulfillment Lambda timeout to 30s\n_Viktor Voltaire, 2026-10-25. 1 Terraform file(s) changed._\n\n**Gate: PASS**\n\n| Changes | Findings to review | Fixed monthly cost |\n| :-- | :-- | :-- |\n| 1 update | none | $0 |\n\n### Changes\n\n| Risk | Resource | Action | Why |\n| :-- | :-- | :-- | :-- |\n| INFO | `module.fulfillment.aws_lambda_function.fulfillment` | update | Timeout: 15 -> 30 |\n\n---\n<sub>Static replay of d40dfb51d..fb2f40942: configuration at both commits was evaluated without state, credentials or provider calls.</sub><br>\n<sub>Roots: infra/envs/prod/fulfillment.</sub><br>\n<sub>Diffseal 0.2.0-beta. Controls cite ISO/IEC 27001:2022 Annex A; whether a check is required is set by your policy, not by the standard.</sub>\n",
        "README.md": "# Acme Fulfillment demo for Diffseal\n\nSynthetic repository showing how Diffseal reviews Terraform changes without AWS credentials or running `terraform`.\n\n## Repository layout\n\n- `infra/modules/fulfillment/main.tf`: Reusable Terraform module provisioning an S3 bucket (`acme-prod-shipment-manifests`), an SQS queue with a dead-letter queue (`acme-prod-dispatch`), a DynamoDB table (`acme-prod-shipments`), an IAM role (`acme-prod-fulfillment-lambda`), and a Lambda function (`acme-prod-fulfillment`).\n- `infra/envs/prod/fulfillment/main.tf`: Production Terraform root calling `module.fulfillment`.\n- `src/fulfillmentHandler.ts`: TypeScript Lambda handler using `@aws-sdk/client-s3`, `@aws-sdk/client-dynamodb`, and `@aws-sdk/client-sqs`.\n- `.github/workflows/diffseal.yml`: GitHub Action workflow configured with `uses: diffseal/diffseal@v0.2.0-beta` and `advisory: 'true'`.\n\n## Demo branches\n\nEach branch represents a pull request against `main` and contains a `PR.md` file with the exact output from running the Diffseal CLI:\n\n1. `pr/replace-database`: Changes the DynamoDB table `hash_key` from `shipment_id` to `tracking_number`. Diffseal detects that `hash_key` forces replacement of `module.fulfillment.aws_dynamodb_table.shipments` and sets `Gate: BLOCK`.\n2. `pr/harmless-change`: Increases the Lambda `timeout` from `15` to `30` seconds in `infra/modules/fulfillment/main.tf`. Diffseal classifies the change as an in-place update with no policy or blast-radius findings and sets `Gate: PASS`.\n\n## Running the checks locally\n\nFrom the `diffseal` repository:\n\n```bash\n# Replay either pull request branch against main\nbun run src/cli.ts replay --repo ../diffseal-demo --commit pr/replace-database --base main --out-dir /tmp/diffseal-demo-runs\nbun run src/cli.ts replay --repo ../diffseal-demo --commit pr/harmless-change --base main --out-dir /tmp/diffseal-demo-runs\n```\n",
        "infra/envs/prod/fulfillment/main.tf": "terraform {\n  backend \"s3\" {\n    bucket = \"acme-terraform-state\"\n    key    = \"fulfillment/terraform.tfstate\"\n    region = \"eu-north-1\"\n  }\n}\n\nprovider \"aws\" {\n  region = \"eu-north-1\"\n}\n\nmodule \"fulfillment\" {\n  source      = \"../../../modules/fulfillment\"\n  environment = \"prod\"\n}\n",
        "infra/modules/fulfillment/main.tf": "variable \"environment\" {\n  type = string\n}\n\nlocals {\n  name = \"acme-${var.environment}\"\n}\n\nresource \"aws_s3_bucket\" \"manifests\" {\n  bucket = \"${local.name}-shipment-manifests\"\n}\n\nresource \"aws_s3_bucket_public_access_block\" \"manifests\" {\n  bucket                  = aws_s3_bucket.manifests.id\n  block_public_acls       = true\n  block_public_policy     = true\n  ignore_public_acls      = true\n  restrict_public_buckets = true\n}\n\nresource \"aws_s3_bucket_versioning\" \"manifests\" {\n  bucket = aws_s3_bucket.manifests.id\n  versioning_configuration {\n    status = \"Enabled\"\n  }\n}\n\nresource \"aws_sqs_queue\" \"dispatch_dlq\" {\n  name = \"${local.name}-dispatch-dlq\"\n}\n\nresource \"aws_sqs_queue\" \"dispatch\" {\n  name = \"${local.name}-dispatch\"\n  redrive_policy = jsonencode({\n    deadLetterTargetArn = aws_sqs_queue.dispatch_dlq.arn\n    maxReceiveCount     = 5\n  })\n}\n\nresource \"aws_dynamodb_table\" \"shipments\" {\n  name         = \"${local.name}-shipments\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"shipment_id\"\n\n  attribute {\n    name = \"shipment_id\"\n    type = \"S\"\n  }\n\n  point_in_time_recovery {\n    enabled = true\n  }\n}\n\nresource \"aws_iam_role\" \"lambda\" {\n  name = \"${local.name}-fulfillment-lambda\"\n  assume_role_policy = jsonencode({\n    Version   = \"2012-10-17\"\n    Statement = [{ Effect = \"Allow\", Principal = { Service = \"lambda.amazonaws.com\" }, Action = \"sts:AssumeRole\" }]\n  })\n}\n\nresource \"aws_iam_role_policy_attachment\" \"logs\" {\n  role       = aws_iam_role.lambda.name\n  policy_arn = \"arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole\"\n}\n\ndata \"aws_iam_policy_document\" \"lambda\" {\n  statement {\n    actions   = [\"s3:PutObject\", \"s3:GetObject\"]\n    resources = [\"${aws_s3_bucket.manifests.arn}/*\"]\n  }\n  statement {\n    actions   = [\"sqs:SendMessage\"]\n    resources = [aws_sqs_queue.dispatch.arn]\n  }\n  statement {\n    actions   = [\"dynamodb:PutItem\", \"dynamodb:GetItem\"]\n    resources = [aws_dynamodb_table.shipments.arn]\n  }\n}\n\nresource \"aws_iam_role_policy\" \"lambda\" {\n  role   = aws_iam_role.lambda.id\n  policy = data.aws_iam_policy_document.lambda.json\n}\n\nresource \"aws_lambda_function\" \"fulfillment\" {\n  function_name = \"${local.name}-fulfillment\"\n  role          = aws_iam_role.lambda.arn\n  package_type  = \"Image\"\n  image_uri     = \"123456789012.dkr.ecr.eu-north-1.amazonaws.com/acme-fulfillment:latest\"\n  memory_size   = 512\n  timeout       = 30\n\n  environment {\n    variables = {\n      MANIFEST_BUCKET_NAME = aws_s3_bucket.manifests.id\n      DISPATCH_QUEUE_URL   = aws_sqs_queue.dispatch.url\n      SHIPMENTS_TABLE_NAME = aws_dynamodb_table.shipments.name\n    }\n  }\n}\n",
        "package.json": "{\n  \"name\": \"acme-fulfillment\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"dependencies\": {\n    \"@aws-sdk/client-dynamodb\": \"^3.600.0\",\n    \"@aws-sdk/client-s3\": \"^3.600.0\",\n    \"@aws-sdk/client-sqs\": \"^3.600.0\"\n  }\n}\n",
        "src/fulfillmentHandler.ts": "import { SQSClient, SendMessageCommand } from '@aws-sdk/client-sqs';\nimport { S3Client, PutObjectCommand, GetObjectCommand } from '@aws-sdk/client-s3';\nimport { DynamoDBClient, PutItemCommand, GetItemCommand } from '@aws-sdk/client-dynamodb';\n\nconst sqs = new SQSClient({ region: 'eu-north-1' });\nconst s3 = new S3Client({ region: 'eu-north-1' });\nconst dynamo = new DynamoDBClient({ region: 'eu-north-1' });\n\nexport async function createShipment(shipmentId: string, customerId: string, manifestPdf: Buffer) {\n  await s3.send(\n    new PutObjectCommand({\n      Bucket: process.env.MANIFEST_BUCKET_NAME,\n      Key: `manifests/${shipmentId}.pdf`,\n      Body: manifestPdf,\n    })\n  );\n\n  await dynamo.send(\n    new PutItemCommand({\n      TableName: process.env.SHIPMENTS_TABLE_NAME,\n      Item: {\n        shipment_id: { S: shipmentId },\n        customer_id: { S: customerId },\n        created_at: { S: new Date().toISOString() },\n      },\n    })\n  );\n\n  await sqs.send(\n    new SendMessageCommand({\n      QueueUrl: process.env.DISPATCH_QUEUE_URL,\n      MessageBody: JSON.stringify({ shipmentId, customerId }),\n    })\n  );\n}\n\nexport async function getShipmentManifest(shipmentId: string) {\n  return s3.send(\n    new GetObjectCommand({\n      Bucket: process.env.MANIFEST_BUCKET_NAME,\n      Key: `manifests/${shipmentId}.pdf`,\n    })\n  );\n}\n\nexport async function getShipmentRecord(shipmentId: string) {\n  return dynamo.send(\n    new GetItemCommand({\n      TableName: process.env.SHIPMENTS_TABLE_NAME,\n      Key: {\n        shipment_id: { S: shipmentId },\n      },\n    })\n  );\n}\n"
      },
      "gate": "pass",
      "exit": 0,
      "finding": "Timeout: 15 -> 30"
    }
  ]
}
