{
  "name": "diffseal",
  "version": "0.6.2-beta",
  "description": "Change review for Terraform on AWS: blast radius, policy checks and change evidence",
  "type": "module",
  "bin": {
    "diffseal": "dist/cli.js",
    "diffseal-mcp": "dist/mcp.js"
  },
  "files": [
    "dist/cli.js",
    "dist/mcp.js",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diffseal/diffseal.git"
  },
  "homepage": "https://diffseal.com",
  "bugs": {
    "url": "https://github.com/diffseal/diffseal/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/check-bun-version.ts && bun build src/cli.ts --target=node --minify-syntax --minify-whitespace --outdir dist && bun build src/mcp.ts --target=node --minify-syntax --minify-whitespace --outdir dist && bun build src/action.ts --target=node --minify-syntax --minify-whitespace --outdir dist",
    "dev": "bun run src/cli.ts",
    "demo": "bun run src/cli.ts demo",
    "typecheck": "tsc --noEmit -p .",
    "mcp": "bun run src/mcp.ts",
    "test": "bun test"
  },
  "keywords": [
    "terraform",
    "aws",
    "iam",
    "change-management",
    "iso27001",
    "soc2",
    "audit",
    "github-action",
    "cli"
  ],
  "license": "FSL-1.1-ALv2",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/bun": "1.3.1",
    "@types/node": "22",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
