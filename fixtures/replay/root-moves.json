    "svc/new/main.tf": "terraform {\n  backend \"s3\" {\n    bucket = \"state\"\n    key    = \"svc.tfstate\"\n  }\n}\n",
    "svc/new/s.tf": "resource \"aws_secretsmanager_secret\" \"argocd\" {\n  name                    = \"argocd-v2\"\n  recovery_window_in_days = 0\n}\nresource \"aws_route53_zone\" \"z\" {\n  name = \"example.com\"\n}\n",
    "other/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name = \"other\"\n}\n"
   },
   "expect": {
    "replayedRoots": [
     "svc/new"
    ],
    "changes": [
     {
      "address": "aws_secretsmanager_secret.argocd",
      "action": "replace",
      "confidence": "proven"
     }
    ],
    "gate": {
     "result": "block"
    }
   }
  },
  {
