          },
          {
            "resource": "aws_sqs_queue.q",
            "action": "create",
            "severity": "INFO",
            "dataLoss": false,
            "reasonContains": "Creates aws_sqs_queue"
          }
        ],
        "cost": {
          "fixedMonthlyDeltaUsd": 1,
          "items": [
            {
              "resource": "aws_kms_key.k",
