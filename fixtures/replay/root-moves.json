{
 "suite": "replay/root-moves",
 "description": "Terraform root directories that are deleted or moved: a move is compared with its old directory, and a deleted directory's resources are destroyed only if someone runs destroy against its state.",
 "cases": [
  {
   "kind": "replay",
   "name": "a root moved to a new directory unchanged destroys nothing; with no fixed state location it is reviewed, not blocked (source case: terraform-aws-eks-blueprints 8aa4515b4, examples/ moved to patterns/)",
   "base": {
    "examples/argocd/main.tf": "terraform {\n  backend \"s3\" {}\n}\n",
    "examples/argocd/secrets.tf": "resource \"aws_secretsmanager_secret\" \"argocd\" {\n  name                    = \"argocd\"\n  recovery_window_in_days = 0\n}\nresource \"aws_route53_zone\" \"z\" {\n  name = \"example.com\"\n}\n",
    "other/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name = \"other\"\n}\n"
   },
   "head": {
    "patterns/argocd/main.tf": "terraform {\n  backend \"s3\" {}\n}\n",
    "patterns/argocd/secrets.tf": "resource \"aws_secretsmanager_secret\" \"argocd\" {\n  name                    = \"argocd\"\n  recovery_window_in_days = 0\n}\nresource \"aws_route53_zone\" \"z\" {\n  name = \"example.com\"\n}\n",
    "other/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name = \"other\"\n}\n"
   },
   "expect": {
    "replayedRoots": [
     "patterns/argocd"
    ],
    "changedAddresses": [],
    "noProvenDelete": true,
    "gate": {
     "result": "review",
     "reasonsContain": [
      "examples/argocd",
      "patterns/argocd",
      "state"
     ]
    },
    "reasonsNotContain": [
     "CRITICAL",
     "Deletes"
    ]
   }
  },
  {
   "kind": "replay",
   "name": "a root moved with the same literal backend state key is the same state: an unchanged move passes",
   "base": {
    "svc/old/main.tf": "terraform {\n  backend \"s3\" {\n    bucket = \"state\"\n    key    = \"svc.tfstate\"\n  }\n}\n",
    "svc/old/q.tf": "resource \"aws_sqs_queue\" \"q\" {\n  name = \"jobs\"\n}\n",
    "other/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name = \"other\"\n}\n"
   },
   "head": {
    "svc/new/main.tf": "terraform {\n  backend \"s3\" {\n    bucket = \"state\"\n    key    = \"svc.tfstate\"\n  }\n}\n",
    "svc/new/q.tf": "resource \"aws_sqs_queue\" \"q\" {\n  name = \"jobs\"\n}\n",
    "other/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name = \"other\"\n}\n"
   },
   "expect": {
    "replayedRoots": [
     "svc/new"
    ],
    "changedAddresses": [],
    "gate": {
     "result": "pass"
    }
   }
  },
  {
   "kind": "replay",
   "name": "a moved root is compared with its old directory, so a real replacement inside it is still found",
   "base": {
    "svc/old/main.tf": "terraform {\n  backend \"s3\" {\n    bucket = \"state\"\n    key    = \"svc.tfstate\"\n  }\n}\n",
    "svc/old/q.tf": "resource \"aws_sqs_queue\" \"q\" {\n  name = \"jobs\"\n}\n",
    "other/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name = \"other\"\n}\n"
   },
   "head": {
    "svc/new/main.tf": "terraform {\n  backend \"s3\" {\n    bucket = \"state\"\n    key    = \"svc.tfstate\"\n  }\n}\n",
    "svc/new/q.tf": "resource \"aws_sqs_queue\" \"q\" {\n  name = \"jobs-v2\"\n}\n",
    "other/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name = \"other\"\n}\n"
   },
   "expect": {
    "replayedRoots": [
     "svc/new"
    ],
    "changes": [
     {
      "address": "aws_sqs_queue.q",
      "action": "replace",
      "confidence": "proven"
     }
    ],
    "gate": {
     "result": "block"
    }
   }
  },
  {
   "kind": "replay",
   "name": "a moved root that renames a stateful resource with the same state key still blocks",
