      "name": "round 12 codex: policy and cost: a KMS data source lookup of a key not known statically is UNKNOWN, a managed key is still a CMK [2]",
      "root": "r",
      "head": {
        "r/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_kms_key\" \"k\" {}\nresource \"aws_sqs_queue\" \"q\" {\n  name              = \"q\"\n  kms_master_key_id = aws_kms_key.k.arn\n}\n"
