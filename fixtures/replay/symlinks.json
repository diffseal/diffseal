{
 "suite": "replay/symlinks",
 "description": "Symbolic links in the repository: links to files and directories inside it are followed at the replayed commit; links that leave it are refused.",
 "cases": [
  {
   "kind": "replay",
   "name": "a symlinked .tf file is read from its target, not parsed as link text (source case: forms-deploy 86d2c17f8, inputs.tf symlinked into every root)",
   "base": {
    "shared/versions.tf": "terraform {\n  required_providers {\n    aws = {\n      source  = \"hashicorp/aws\"\n      version = \"6.66.0\"\n    }\n  }\n}\n",
    "shared/inputs.tf": "variable \"bucket_name\" {\n  type    = string\n  default = \"logs\"\n}\n",
    "envs/prod/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_s3_bucket\" \"b\" {\n  bucket = var.bucket_name\n}\n"
   },
   "head": {
    "shared/versions.tf": "terraform {\n  required_providers {\n    aws = {\n      source  = \"hashicorp/aws\"\n      version = \"6.66.0\"\n    }\n  }\n}\n",
    "shared/inputs.tf": "variable \"bucket_name\" {\n  type    = string\n  default = \"logs\"\n}\n",
    "envs/prod/main.tf": "terraform {\n  backend \"s3\" {}\n}\nresource \"aws_s3_bucket\" \"b\" {\n  bucket = var.bucket_name\n}\nresource \"aws_sqs_queue\" \"q\" {\n  name = \"q\"\n}\n"
   },
   "baseLinks": {
    "envs/prod/versions.tf": "../../shared/versions.tf",
    "envs/prod/inputs.tf": "../../shared/inputs.tf"
   },
   "headLinks": {
    "envs/prod/versions.tf": "../../shared/versions.tf",
    "envs/prod/inputs.tf": "../../shared/inputs.tf"
   },
   "expect": {
    "replayedRoots": [
     "envs/prod"
    ],
    "rootDiagnostics": [],
    "changedAddresses": [
     "create aws_sqs_queue.q"
    ],
    "changes": [
     {
      "address": "aws_s3_bucket.b",
      "action": "no-op",
      "after": {
       "bucket": "logs"
      }
     }
    ],
    "gate": {
     "result": "pass"
    }
   }
  },
