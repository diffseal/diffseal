{
  "suite": "app/typescript",
  "description": "Executable specification fixtures exported from src/app/typescript.test.ts",
  "cases": [
    {
      "kind": "app",
      "name": "extractTs: SDK v3 commands with env, literal and template resources",
      "files": {
        "a.ts": "import { S3Client, PutObjectCommand, GetObjectCommand } from '@aws-sdk/client-s3';\nimport { SendMessageCommand } from \"@aws-sdk/client-sqs\";\nconst bucket = process.env.INVOICE_BUCKET!;\nexport async function run(id: string) {\n  await s3.send(new PutObjectCommand({ Bucket: bucket, Key: id, Body: 'x' }));\n  await s3.send(new GetObjectCommand({ Bucket: `exports-${stage}`, Key: id }));\n  await sqs.send(new SendMessageCommand({ QueueUrl: process.env['JOBS_QUEUE_URL'], MessageBody: '{}' }));\n}\n"
      },
      "expect": {
        "exactResources": [
          {
            "kind": "env",
            "name": "INVOICE_BUCKET"
          },
          {
            "kind": "pattern",
            "glob": "exports-*"
          },
          {
            "kind": "env",
            "name": "JOBS_QUEUE_URL"
          }
        ],
        "facts": [
          {
            "service": "s3",
            "operation": "PutObject",
            "actions": [
              "s3:PutObject"
            ],
            "resource": {
              "kind": "env",
              "name": "INVOICE_BUCKET"
            },
            "file": "a.ts"
          },
          {
            "service": "s3",
            "operation": "GetObject",
            "actions": [
              "s3:GetObject"
            ],
            "resource": {
              "kind": "pattern",
              "glob": "exports-*"
            },
            "file": "a.ts"
          },
          {
            "service": "sqs",
            "operation": "SendMessage",
            "actions": [
              "sqs:SendMessage"
            ],
            "resource": {
              "kind": "env",
              "name": "JOBS_QUEUE_URL"
            },
            "file": "a.ts"
          }
        ],
        "envReads": [
          {
            "name": "INVOICE_BUCKET"
          },
          {
            "name": "JOBS_QUEUE_URL"
          }
        ]
      }
    },
